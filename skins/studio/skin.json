{
  "formatVersion": 1,
  "id": "io.github.krocon.studio",
  "name": "Studio",
  "version": "1.0.0",
  "author": "FLAC Commander",
  "description": "A recorder in black leather with a cream meter panel, steel knobs and tabs that light up blue.",
  "keywords": [
    "recorder",
    "leather",
    "meter",
    "cream",
    "steel",
    "skeuomorphic"
  ],
  "preview": "preview.webp",
  "theme": {
    "background": "#e9dfbf",
    "surface": "#f4ecd2",
    "surfaceRaised": "#fffaf0",
    "foreground": "#2a2418",
    "muted": "#62573f",
    "accent": "#a3261c",
    "accentContrast": "#fff8ec",
    "border": "#8d8262",
    "ok": "#1f6b3a",
    "danger": "#a3261c",
    "focus": "#1f5fbf",
    "fontFamily": "\"Georgia\", \"Times New Roman\", serif",
    "fontMono": "\"Georgia\", \"Times New Roman\", serif",
    "radius": 3
  },
  "windows": {
    "player": {
      "layout": "absolute",
      "width": 380,
      "height": 466,
      "background": "assets/background.png",
      "titleBar": "#26282b",
      "collapsedHeight": 298,
      "resize": {
        "stretchY": 377
      },
      "components": [
        {
          "type": "text",
          "source": "track.title",
          "x": 40,
          "y": 52,
          "width": 300,
          "height": 22,
          "fontSize": 16,
          "align": "center",
          "color": "#2a2418"
        },
        {
          "type": "text",
          "source": "track.artist",
          "x": 40,
          "y": 74,
          "width": 300,
          "height": 16,
          "fontSize": 12,
          "align": "center",
          "color": "#62573f"
        },
        {
          "type": "time",
          "source": "position",
          "x": 40,
          "y": 98,
          "width": 90,
          "height": 30,
          "fontSize": 22,
          "color": "#a3261c"
        },
        {
          "type": "spectrum",
          "x": 136,
          "y": 102,
          "width": 108,
          "height": 24,
          "color": "#62573f"
        },
        {
          "type": "text",
          "source": "player.status",
          "x": 250,
          "y": 100,
          "width": 90,
          "height": 14,
          "fontSize": 10,
          "align": "right",
          "color": "#a3261c"
        },
        {
          "type": "time",
          "source": "duration",
          "x": 250,
          "y": 114,
          "width": 90,
          "height": 14,
          "fontSize": 11,
          "align": "right",
          "color": "#62573f"
        },
        {
          "type": "seekbar",
          "x": 24,
          "y": 153,
          "width": 332,
          "height": 8
        },
        {
          "type": "volume",
          "x": 186,
          "y": 271,
          "width": 60,
          "height": 8
        },
        {
          "type": "button",
          "action": "player.open",
          "x": 44,
          "y": 185,
          "width": 54,
          "height": 54,
          "states": {
            "normal": "assets/open.png",
            "hover": "assets/open-hover.png",
            "pressed": "assets/open-pressed.png"
          }
        },
        {
          "type": "button",
