{
  "formatVersion": 1,
  "id": "io.github.krocon.beat",
  "name": "Beat",
  "version": "1.0.0",
  "author": "FLAC Commander",
  "description": "A drum machine in warm dark rubber, with one pad that glows pink while the music plays.",
  "keywords": [
    "drum machine",
    "dark",
    "pink",
    "rubber",
    "glow"
  ],
  "preview": "preview.webp",
  "theme": {
    "background": "#3b3835",
    "surface": "#221f1d",
    "surfaceRaised": "#4a4642",
    "foreground": "#f1ece4",
    "muted": "#b9b1a6",
    "accent": "#ff7ab6",
    "accentContrast": "#2a0014",
    "border": "#151312",
    "ok": "#7fdca0",
    "danger": "#ffa39b",
    "focus": "#7fc4ff",
    "fontFamily": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "fontMono": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "radius": 3
  },
  "windows": {
    "player": {
      "layout": "absolute",
      "width": 380,
      "height": 470,
      "background": "assets/background.png",
      "resize": {
        "stretchY": 381
      },
      "components": [
        {
          "type": "text",
          "source": "track.title",
          "x": 36,
          "y": 28,
          "width": 308,
          "height": 22,
          "fontSize": 16,
          "color": "#f1ece4"
        },
        {
          "type": "text",
          "source": "track.artist",
          "x": 36,
          "y": 51,
          "width": 308,
          "height": 16,
          "fontSize": 12,
          "color": "#ff7ab6"
        },
        {
          "type": "time",
          "source": "position",
          "x": 36,
          "y": 74,
          "width": 100,
          "height": 38,
          "fontSize": 28,
          "color": "#f1ece4"
        },
        {
          "type": "spectrum",
          "x": 144,
          "y": 80,
          "width": 110,
          "height": 28,
          "color": "#ff7ab6"
        },
        {
          "type": "text",
          "source": "player.status",
          "x": 260,
          "y": 80,
          "width": 84,
          "height": 14,
          "fontSize": 10,
          "align": "right",
          "color": "#ff7ab6"
        },
        {
          "type": "time",
          "source": "duration",
          "x": 260,
          "y": 96,
          "width": 84,
          "height": 14,
          "fontSize": 11,
          "align": "right",
          "color": "#b9b1a6"
        },
        {
          "type": "seekbar",
          "x": 24,
          "y": 143,
          "width": 332,
          "height": 8
        },
        {
          "type": "volume",
          "x": 174,
          "y": 272,
          "width": 126,
          "height": 8
        },
        {
          "type": "button",
          "action": "player.open",
          "x": 36,
          "y": 178,
          "width": 56,
          "height": 56,
          "states": {
            "normal": "assets/open.png",
            "hover": "assets/open-hover.png",
            "pressed": "assets/open-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.previous",
          "x": 92,
          "y": 178,
          "width": 56,
          "height": 56,
          "states": {
            "normal": "assets/previous.png",
            "hover": "assets/previous-hover.png",
            "pressed": "assets/previous-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.togglePlay",
          "x": 148,
          "y": 164,
          "width": 84,
          "height": 84,
          "states": {
            "normal": "assets/play.png",
            "hover": "assets/play-hover.png",
            "pressed": "assets/play-pressed.png",
            "active": "assets/play-active.png"
          }
        },
        {
          "type": "button",
          "action": "player.next",
          "x": 232,
          "y": 178,
          "width": 56,
          "height": 56,
          "states": {
            "normal": "assets/next.png",
            "hover": "assets/next-hover.png",
            "pressed": "assets/next-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.stop",
          "x": 288,
          "y": 178,
          "width": 56,
          "height": 56,
          "states": {
            "normal": "assets/stop.png",
            "hover": "assets/stop-hover.png",
            "pressed": "assets/stop-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.repeat",
          "x": 22,
          "y": 256,
          "width": 46,
          "height": 40,
          "states": {
            "normal": "assets/repeat.png",
            "hover": "assets/repeat-hover.png",
            "pressed": "assets/repeat-pressed.png",
            "active": "assets/repeat-active.png"
          }
        },
        {
          "type": "button",
          "action": "player.shuffle",
          "x": 68,
          "y": 256,
          "width": 46,
          "height": 40,
          "states": {
            "normal": "assets/shuffle.png",
            "hover": "assets/shuffle-hover.png",
            "pressed": "assets/shuffle-pressed.png",
            "active": "assets/shuffle-active.png"
          }
        },
        {
          "type": "button",
          "action": "window.equalizer",
          "x": 114,
          "y": 256,
          "width": 46,
          "height": 40,
          "states": {
            "normal": "assets/equalizer.png",
            "hover": "assets/equalizer-hover.png",
            "pressed": "assets/equalizer-pressed.png",
            "active": "assets/equalizer-active.png"
          }
        },
        {
          "type": "button",
          "action": "app.skins",
          "x": 312,
          "y": 256,
          "width": 46,
          "height": 40,
          "states": {
            "normal": "assets/skins.png",
            "hover": "assets/skins-hover.png",
            "pressed": "assets/skins-pressed.png"
          }
        },
        {
          "type": "playlist",
          "x": 28,
          "y": 310,
          "width": 324,
          "height": 142
        }
      ]
    }
  }
}
