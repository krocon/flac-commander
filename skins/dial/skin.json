          "y": 488,
          "width": 76,
          "height": 8
        },
        {
          "type": "button",
          "action": "player.open",
          "x": 26,
          "y": 408,
          "width": 52,
          "height": 52,
          "states": {
            "normal": "assets/open.png",
            "hover": "assets/open-hover.png",
            "pressed": "assets/open-pressed.png"
          }
        },
        {
