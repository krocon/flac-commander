        {
          "type": "playlist",
          "x": 26,
          "y": 520,
          "width": 308,
          "height": 140
        },
        {
          "type": "needle",
          "x": 70,
          "y": 130,
          "width": 220,
          "height": 220,
          "pivotX": 110,
          "pivotY": 110,
          "from": -140,
