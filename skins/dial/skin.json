{
  "formatVersion": 1,
  "id": "io.github.krocon.dial",
  "name": "Dial",
  "version": "1.0.0",
  "author": "FLAC Commander",
  "description": "One big turned aluminium knob: its green mark shows the position, turning it seeks.",
  "keywords": [
    "dial",
    "knob",
    "aluminium",
    "light",
    "minimal",
    "green"
  ],
  "preview": "preview.webp",
  "theme": {
    "background": "#e3e4e5",
    "surface": "#f3f4f5",
    "surfaceRaised": "#ffffff",
    "foreground": "#1c1d1f",
    "muted": "#54575a",
    "accent": "#256b0c",
    "accentContrast": "#ffffff",
    "border": "#a5a7a9",
    "ok": "#256b0c",
    "danger": "#a3231b",
    "focus": "#1f5fbf",
    "fontFamily": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "fontMono": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "radius": 3
  },
  "windows": {
    "player": {
      "layout": "absolute",
      "width": 360,
      "height": 680,
      "background": "assets/background.png",
      "collapsedHeight": 512,
      "resize": {
        "stretchY": 590
      },
      "components": [
        {
          "type": "time",
          "source": "position",
          "x": 24,
          "y": 14,
          "width": 312,
          "height": 44,
          "fontSize": 34,
          "align": "center",
          "color": "#1c1d1f"
        },
        {
          "type": "text",
          "source": "track.title",
          "x": 24,
          "y": 60,
          "width": 312,
          "height": 22,
          "fontSize": 15,
          "align": "center",
          "color": "#1c1d1f"
        },
        {
          "type": "text",
          "source": "track.artist",
          "x": 24,
          "y": 82,
          "width": 312,
          "height": 16,
          "fontSize": 11,
          "align": "center",
          "color": "#54575a"
        },
        {
          "type": "text",
          "source": "player.status",
          "x": 24,
          "y": 376,
          "width": 90,
          "height": 16,
          "fontSize": 10,
          "color": "#256b0c"
        },
        {
          "type": "spectrum",
          "x": 120,
          "y": 374,
          "width": 120,
          "height": 18,
          "color": "#256b0c"
        },
        {
          "type": "time",
