{
  "formatVersion": 1,
  "id": "io.github.krocon.switch",
  "name": "Switch",
  "version": "1.0.0",
  "author": "FLAC Commander",
  "description": "Soft white with round keys in cream, red and green, a lever and a black rocker.",
  "keywords": [
    "white",
    "light",
    "soft",
    "switches",
    "minimal",
    "sixties"
  ],
  "preview": "preview.webp",
  "theme": {
    "background": "#f1f0ec",
    "surface": "#ffffff",
    "surfaceRaised": "#ffffff",
    "foreground": "#1d1d1b",
    "muted": "#52524e",
    "accent": "#a8321a",
    "accentContrast": "#ffffff",
    "border": "#a4a39e",
    "ok": "#2f6a3c",
    "danger": "#a8321a",
    "focus": "#1f5fbf",
    "fontFamily": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "fontMono": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "radius": 3
  },
  "windows": {
    "player": {
      "layout": "absolute",
      "width": 360,
      "height": 464,
      "background": "assets/background.png",
      "titleBar": "#fafaf9",
      "collapsedHeight": 296,
      "resize": {
        "stretchY": 375
      },
      "components": [
        {
          "type": "text",
          "source": "track.title",
          "x": 34,
          "y": 28,
          "width": 208,
          "height": 22,
          "fontSize": 16,
          "color": "#1d1d1b"
        },
        {
          "type": "text",
          "source": "track.artist",
          "x": 34,
          "y": 51,
          "width": 208,
          "height": 16,
          "fontSize": 12,
          "color": "#a8321a"
        },
        {
          "type": "time",
          "source": "position",
          "x": 34,
          "y": 74,
          "width": 100,
          "height": 38,
          "fontSize": 28,
          "color": "#1d1d1b"
        },
        {
          "type": "text",
          "source": "player.status",
          "x": 158,
          "y": 80,
          "width": 84,
          "height": 14,
          "fontSize": 10,
          "align": "right",
          "color": "#a8321a"
        },
        {
          "type": "time",
          "source": "duration",
          "x": 158,
          "y": 96,
          "width": 84,
          "height": 14,
          "fontSize": 11,
          "align": "right",
          "color": "#52524e"
        },
        {
          "type": "seekbar",
          "x": 24,
          "y": 153,
          "width": 312,
          "height": 8
        },
        {
          "type": "volume",
          "x": 180,
          "y": 264,
          "width": 50,
          "height": 8
        },
        {
          "type": "button",
          "action": "player.open",
          "x": 36,
          "y": 178,
          "width": 56,
          "height": 56,
          "states": {
            "normal": "assets/open.png",
            "hover": "assets/open-hover.png",
            "pressed": "assets/open-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.previous",
          "x": 92,
          "y": 178,
