{
  "formatVersion": 1,
  "id": "io.github.krocon.neon",
  "name": "Neon",
  "version": "1.0.0",
  "author": "FLAC Commander",
  "description": "Glowing tubes over a night-time grid: cyan, magenta and a setting sun.",
  "keywords": [
    "neon",
    "synthwave",
    "retro",
    "dark",
    "glow",
    "eighties"
  ],
  "preview": "preview.webp",
  "theme": {
    "background": "#120826",
    "surface": "#0d0620",
    "surfaceRaised": "#25123f",
    "foreground": "#f6edff",
    "muted": "#b9a3da",
    "accent": "#ff5fdc",
    "accentContrast": "#1c0322",
    "border": "#56308a",
    "ok": "#6ff0b0",
    "danger": "#ff9a9a",
    "focus": "#5ff4ff",
    "fontFamily": "\"Avenir Next\", \"Segoe UI\", \"Helvetica Neue\", sans-serif",
    "fontMono": "Menlo, Consolas, monospace",
    "radius": 8
  },
  "windows": {
    "player": {
      "layout": "absolute",
      "width": 380,
      "height": 540,
      "background": "assets/background.png",
      "collapsedHeight": 288,
      "resize": {
        "stretchY": 410
      },
      "components": [
        {
          "type": "text",
          "source": "track.title",
          "x": 28,
          "y": 24,
          "width": 232,
          "height": 22,
          "fontSize": 16,
          "color": "#f6edff"
        },
        {
          "type": "text",
          "source": "track.artist",
          "x": 28,
          "y": 46,
          "width": 232,
          "height": 16,
          "fontSize": 12,
          "color": "#5ff4ff"
        },
        {
          "type": "time",
          "source": "position",
          "x": 28,
          "y": 72,
          "width": 108,
          "height": 40,
          "fontSize": 30,
          "color": "#ff5fdc"
        },
        {
          "type": "spectrum",
          "x": 144,
          "y": 82,
          "width": 112,
          "height": 28,
          "color": "#5ff4ff"
        },
        {
          "type": "text",
          "source": "player.status",
          "x": 28,
          "y": 112,
          "width": 150,
          "height": 14,
          "fontSize": 10,
          "color": "#b9a3da"
        },
        {
          "type": "time",
          "source": "duration",
          "x": 190,
          "y": 112,
          "width": 66,
          "height": 14,
          "fontSize": 10,
          "align": "right",
          "color": "#b9a3da"
        },
        {
          "type": "seekbar",
          "x": 14,
          "y": 145,
          "width": 352,
          "height": 8
        },
        {
          "type": "volume",
          "x": 128,
          "y": 252,
          "width": 124,
          "height": 8
        },
        {
          "type": "button",
          "action": "player.stop",
          "x": 57,
          "y": 174,
          "width": 50,
          "height": 50,
          "states": {
            "normal": "assets/stop.png",
            "hover": "assets/stop-hover.png",
            "pressed": "assets/stop-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.previous",
          "x": 107,
          "y": 174,
          "width": 50,
          "height": 50,
          "states": {
            "normal": "assets/previous.png",
            "hover": "assets/previous-hover.png",
            "pressed": "assets/previous-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.togglePlay",
          "x": 157,
          "y": 166,
          "width": 66,
          "height": 66,
          "states": {
            "normal": "assets/play.png",
            "hover": "assets/play-hover.png",
            "pressed": "assets/play-pressed.png",
            "active": "assets/play-active.png"
          }
        },
        {
          "type": "button",
          "action": "player.next",
          "x": 223,
          "y": 174,
          "width": 50,
          "height": 50,
          "states": {
            "normal": "assets/next.png",
            "hover": "assets/next-hover.png",
            "pressed": "assets/next-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.open",
          "x": 273,
          "y": 174,
          "width": 50,
          "height": 50,
          "states": {
            "normal": "assets/open.png",
            "hover": "assets/open-hover.png",
            "pressed": "assets/open-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.repeat",
          "x": 9,
          "y": 236,
          "width": 54,
          "height": 40,
          "states": {
            "normal": "assets/repeat.png",
            "hover": "assets/repeat-hover.png",
            "pressed": "assets/repeat-pressed.png",
            "active": "assets/repeat-active.png"
          }
        },
        {
          "type": "button",
          "action": "player.shuffle",
          "x": 63,
          "y": 236,
          "width": 54,
          "height": 40,
          "states": {
            "normal": "assets/shuffle.png",
            "hover": "assets/shuffle-hover.png",
            "pressed": "assets/shuffle-pressed.png",
            "active": "assets/shuffle-active.png"
          }
        },
        {
          "type": "button",
          "action": "window.equalizer",
          "x": 263,
          "y": 236,
          "width": 54,
          "height": 40,
          "states": {
            "normal": "assets/equalizer.png",
            "hover": "assets/equalizer-hover.png",
            "pressed": "assets/equalizer-pressed.png",
            "active": "assets/equalizer-active.png"
          }
        },
        {
          "type": "button",
          "action": "app.skins",
          "x": 317,
          "y": 236,
          "width": 54,
          "height": 40,
          "states": {
            "normal": "assets/skins.png",
            "hover": "assets/skins-hover.png",
            "pressed": "assets/skins-pressed.png"
          }
        },
        {
          "type": "playlist",
          "x": 20,
          "y": 296,
          "width": 340,
          "height": 224
        }
      ]
    }
  }
}
