{
  "formatVersion": 1,
  "id": "io.github.krocon.recorder-pcm",
  "name": "Recorder (photo)",
  "version": "1.0.0",
  "author": "FLAC Commander",
  "description": "A pocket recorder as a photograph: its display shows the track, its own keys are the keys.",
  "keywords": [
    "recorder",
    "photograph",
    "pocket",
    "display",
    "upright"
  ],
  "preview": "preview.webp",
  "theme": {
    "background": "#ffffff",
    "surface": "#d7dbde",
    "surfaceRaised": "#eceff1",
