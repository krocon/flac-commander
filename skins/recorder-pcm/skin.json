    "accentContrast": "#d7dbde",
    "border": "#5d636a",
    "ok": "#0b5a2b",
    "danger": "#8f1d16",
    "focus": "#1f5fbf",
    "fontFamily": "\"Helvetica Neue\", \"Arial Narrow\", Arial, sans-serif",
