{
  "formatVersion": 1,
  "id": "io.github.krocon.classic",
  "name": "Classic",
  "version": "1.0.0",
  "author": "FLAC Commander",
  "description": "An olive-grey cassette player: the time large on its speaker, a cassette with the cover, an orange key.",
  "keywords": [
    "cassette",
    "player",
    "olive",
    "grey",
    "dark",
    "cover",
    "orange"
  ],
  "preview": "preview.webp",
  "theme": {
    "background": "#3c3d37",
    "surface": "#0f0f0d",
    "surfaceRaised": "#55564f",
    "foreground": "#f5f5f0",
    "muted": "#c9c9bf",
    "accent": "#ff9a3d",
    "accentContrast": "#221000",
    "border": "#1a1a17",
    "ok": "#9fd96a",
    "danger": "#ffa39b",
    "focus": "#7fc4ff",
    "fontFamily": "\"Avenir Next\", \"Segoe UI\", \"Helvetica Neue\", sans-serif",
    "fontMono": "\"Avenir Next\", \"Segoe UI\", \"Helvetica Neue\", sans-serif",
    "radius": 4
  },
