{
  "formatVersion": 1,
  "id": "io.github.krocon.gauge",
  "name": "Gauge",
  "version": "1.0.0",
  "author": "FLAC Commander",
  "description": "Two round instruments lit in cyan on navy, as in a dashboard at night.",
  "keywords": [
    "dashboard",
    "instruments",
    "dark",
    "navy",
    "cyan",
    "glow"
  ],
  "preview": "preview.webp",
  "theme": {
    "background": "#131c2b",
    "surface": "#0a111c",
    "surfaceRaised": "#24324a",
    "foreground": "#eaf3ff",
    "muted": "#9fb2cc",
    "accent": "#5fd8ff",
    "accentContrast": "#001a24",
    "border": "#05090f",
    "ok": "#7fdca0",
    "danger": "#ff9d94",
    "focus": "#ffd166",
    "fontFamily": "\"Avenir Next\", \"Segoe UI\", \"Helvetica Neue\", sans-serif",
    "fontMono": "\"Avenir Next\", \"Segoe UI\", \"Helvetica Neue\", sans-serif",
    "radius": 6
  },
  "windows": {
