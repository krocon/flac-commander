{
  "formatVersion": 1,
  "id": "io.github.krocon.stripe",
  "name": "Stripe",
  "version": "1.0.0",
  "author": "FLAC Commander",
  "description": "A flat drawing: black outlines on cream, a cassette and racing stripes in blue and pink.",
  "keywords": [
    "flat",
    "illustration",
    "light",
    "stripes",
    "cassette",
    "blue",
    "pink"
  ],
  "preview": "preview.webp",
  "theme": {
    "background": "#fbf7ef",
    "surface": "#ffffff",
    "surfaceRaised": "#ffffff",
    "foreground": "#14161a",
    "muted": "#54575e",
    "accent": "#1f56b8",
    "accentContrast": "#ffffff",
    "border": "#14161a",
    "ok": "#1f6b3a",
    "danger": "#a3231b",
    "focus": "#b83216",
    "fontFamily": "\"Avenir Next\", \"Segoe UI\", \"Helvetica Neue\", sans-serif",
    "fontMono": "\"Avenir Next\", \"Segoe UI\", \"Helvetica Neue\", sans-serif",
    "radius": 10
  },
