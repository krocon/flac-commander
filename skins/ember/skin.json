{
  "formatVersion": 1,
  "id": "io.github.krocon.ember",
  "name": "Ember",
  "version": "1.0.0",
  "author": "FLAC Commander",
  "description": "Amber on black: lines of glowing segments, small red keys and narrow print.",
  "keywords": [
    "dark",
    "amber",
    "segments",
    "compact",
    "nineties",
    "red"
  ],
  "preview": "preview.webp",
  "theme": {
    "background": "#100d09",
    "surface": "#060504",
    "surfaceRaised": "#2a2117",
    "foreground": "#f5c56b",
    "muted": "#b88f47",
    "accent": "#ff5a48",
    "accentContrast": "#1c0300",
    "border": "#3a2c18",
    "ok": "#9fd96a",
    "danger": "#ff8f85",
    "focus": "#7fc4ff",
    "fontFamily": "\"Menlo\", \"Consolas\", \"Courier New\", monospace",
    "fontMono": "\"Menlo\", \"Consolas\", \"Courier New\", monospace",
    "radius": 1
  },
  "windows": {
    "player": {
      "layout": "absolute",
      "width": 320,
      "height": 418,
      "background": "assets/background.png",
      "titleBar": "#1d170f",
      "collapsedHeight": 240,
      "resize": {
        "stretchY": 324
      },
      "components": [
        {
          "type": "text",
          "source": "track.title",
          "x": 20,
          "y": 26,
          "width": 280,
          "height": 18,
          "fontSize": 12,
          "color": "#f5c56b"
        },
        {
          "type": "text",
          "source": "track.artist",
          "x": 20,
          "y": 44,
          "width": 180,
          "height": 14,
          "fontSize": 10,
          "color": "#b88f47"
        },
        {
          "type": "text",
          "source": "player.status",
          "x": 204,
          "y": 44,
          "width": 96,
          "height": 14,
          "fontSize": 10,
          "align": "right",
          "color": "#ff5a48"
        },
        {
          "type": "time",
          "source": "position",
          "x": 20,
          "y": 62,
          "width": 90,
          "height": 40,
          "fontSize": 28,
          "color": "#f5c56b"
        },
        {
          "type": "spectrum",
          "x": 116,
          "y": 68,
          "width": 130,
          "height": 32,
          "color": "#f5c56b"
        },
        {
          "type": "time",
          "source": "duration",
          "x": 250,
          "y": 86,
          "width": 50,
          "height": 14,
          "fontSize": 10,
          "align": "right",
          "color": "#b88f47"
        },
        {
          "type": "seekbar",
          "x": 14,
          "y": 121,
          "width": 292,
          "height": 8
        },
        {
          "type": "volume",
          "x": 146,
          "y": 215,
          "width": 70,
          "height": 8
        },
        {
          "type": "button",
          "action": "player.open",
          "x": 25,
          "y": 142,
          "width": 54,
          "height": 54,
          "states": {
            "normal": "assets/open.png",
            "hover": "assets/open-hover.png",
            "pressed": "assets/open-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.previous",
          "x": 79,
          "y": 142,
          "width": 54,
          "height": 54,
          "states": {
            "normal": "assets/previous.png",
            "hover": "assets/previous-hover.png",
            "pressed": "assets/previous-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.togglePlay",
          "x": 133,
          "y": 142,
          "width": 54,
          "height": 54,
          "states": {
            "normal": "assets/play.png",
            "hover": "assets/play-hover.png",
            "pressed": "assets/play-pressed.png",
            "active": "assets/play-active.png"
          }
        },
        {
          "type": "button",
          "action": "player.next",
          "x": 187,
          "y": 142,
          "width": 54,
          "height": 54,
          "states": {
            "normal": "assets/next.png",
            "hover": "assets/next-hover.png",
            "pressed": "assets/next-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.stop",
          "x": 241,
          "y": 142,
          "width": 54,
          "height": 54,
          "states": {
            "normal": "assets/stop.png",
            "hover": "assets/stop-hover.png",
            "pressed": "assets/stop-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.repeat",
          "x": 12,
          "y": 204,
          "width": 40,
          "height": 30,
          "states": {
            "normal": "assets/repeat.png",
            "hover": "assets/repeat-hover.png",
            "pressed": "assets/repeat-pressed.png",
            "active": "assets/repeat-active.png"
          }
        },
        {
          "type": "button",
          "action": "player.shuffle",
          "x": 52,
          "y": 204,
          "width": 40,
          "height": 30,
          "states": {
            "normal": "assets/shuffle.png",
            "hover": "assets/shuffle-hover.png",
            "pressed": "assets/shuffle-pressed.png",
            "active": "assets/shuffle-active.png"
          }
        },
        {
          "type": "button",
          "action": "window.equalizer",
          "x": 92,
          "y": 204,
          "width": 40,
          "height": 30,
          "states": {
            "normal": "assets/equalizer.png",
            "hover": "assets/equalizer-hover.png",
            "pressed": "assets/equalizer-pressed.png",
            "active": "assets/equalizer-active.png"
          }
        },
        {
          "type": "button",
          "action": "app.playlist",
          "x": 228,
          "y": 204,
          "width": 40,
          "height": 30,
          "states": {
            "normal": "assets/playlist.png",
            "hover": "assets/playlist-hover.png",
            "pressed": "assets/playlist-pressed.png",
            "active": "assets/playlist-active.png"
          }
        },
        {
          "type": "button",
          "action": "app.skins",
          "x": 268,
          "y": 204,
          "width": 40,
          "height": 30,
          "states": {
            "normal": "assets/skins.png",
            "hover": "assets/skins-hover.png",
            "pressed": "assets/skins-pressed.png"
          }
        },
        {
          "type": "playlist",
          "x": 18,
          "y": 248,
          "width": 284,
          "height": 152
        }
      ]
    }
  }
}
