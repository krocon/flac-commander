          "x": 100,
          "y": 262,
          "width": 200,
          "height": 18,
          "fontSize": 10,
          "align": "center",
          "color": "#b1b1ad"
        },
        {
          "type": "time",
          "source": "duration",
          "x": 304,
          "y": 262,
          "width": 80,
          "height": 18,
          "fontSize": 13,
          "align": "right",
          "color": "#b1b1ad"
        },
        {
