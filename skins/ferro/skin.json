{
  "formatVersion": 1,
  "id": "io.github.krocon.ferro",
  "name": "Ferro",
  "version": "1.0.0",
  "author": "FLAC Commander",
  "description": "One big black cassette: ribbed shell, white hubs and a number in pale blue.",
  "keywords": [
    "cassette",
    "black",
    "dark",
    "blue",
    "skeuomorphic"
  ],
  "preview": "preview.webp",
  "theme": {
    "background": "#1b1b1c",
    "surface": "#101011",
    "surfaceRaised": "#2e2e30",
    "foreground": "#f3f3f0",
    "muted": "#b1b1ad",
    "accent": "#7dbdff",
    "accentContrast": "#06121f",
    "border": "#000000",
    "ok": "#7fdca0",
    "danger": "#ff9d94",
    "focus": "#ffd166",
    "fontFamily": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "fontMono": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "radius": 3
  },
  "windows": {
    "player": {
      "layout": "absolute",
      "width": 400,
      "height": 570,
      "background": "assets/background.png",
      "collapsedHeight": 402,
      "resize": {
        "stretchY": 480
      },
      "components": [
        {
          "type": "spinner",
          "x": 110,
          "y": 133,
          "width": 36,
          "height": 36,
          "period": 2600,
          "states": {
            "normal": "assets/hub-left.png"
          }
        },
        {
          "type": "spinner",
          "x": 254,
          "y": 133,
          "width": 36,
          "height": 36,
          "period": 2600,
          "states": {
            "normal": "assets/hub-right.png"
          }
        },
        {
          "type": "text",
          "source": "track.title",
          "x": 42,
          "y": 62,
          "width": 240,
          "height": 24,
          "fontSize": 16,
          "color": "#f3f3f0"
        },
        {
          "type": "text",
          "source": "track.artist",
          "x": 42,
          "y": 86,
          "width": 240,
          "height": 18,
          "fontSize": 12,
          "color": "#7dbdff"
        },
        {
          "type": "spectrum",
          "x": 288,
          "y": 66,
          "width": 72,
          "height": 34,
          "color": "#7dbdff"
        },
        {
          "type": "time",
          "source": "position",
          "x": 16,
          "y": 262,
          "width": 80,
          "height": 18,
          "fontSize": 13,
          "color": "#f3f3f0"
        },
        {
          "type": "text",
