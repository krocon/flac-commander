{
  "formatVersion": 1,
  "id": "io.github.krocon.system",
  "name": "System",
  "version": "1.0.0",
  "author": "FLAC Commander",
  "description": "White marks on black: dots, hairlines, a reel that turns and a single green light.",
  "keywords": [
    "minimal",
    "black",
    "white",
    "dots",
    "reel",
    "graphic"
  ],
  "preview": "preview.webp",
  "theme": {
    "background": "#0c0c0c",
    "surface": "#000000",
    "surfaceRaised": "#1f1f1f",
    "foreground": "#f5f5f5",
    "muted": "#a9a9a9",
    "accent": "#49e58f",
    "accentContrast": "#00210e",
    "border": "#5c5c5c",
    "ok": "#49e58f",
    "danger": "#ff8f85",
    "focus": "#7fc4ff",
    "fontFamily": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "fontMono": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "radius": 1
  },
  "windows": {
    "player": {
      "layout": "absolute",
      "width": 380,
      "height": 610,
      "background": "assets/background.png",
      "resize": {
        "stretchY": 500
      },
      "components": [
        {
          "type": "spinner",
          "x": 196,
          "y": 92,
          "width": 164,
          "height": 164,
          "period": 3000,
          "states": {
            "normal": "assets/wheel.png"
          }
        },
        {
          "type": "text",
          "source": "track.title",
          "x": 24,
          "y": 50,
          "width": 332,
          "height": 22,
          "fontSize": 15,
          "color": "#f5f5f5"
        },
        {
          "type": "text",
          "source": "track.artist",
          "x": 24,
          "y": 72,
          "width": 332,
          "height": 16,
          "fontSize": 11,
          "color": "#a9a9a9"
        },
        {
          "type": "time",
          "source": "position",
          "x": 24,
          "y": 104,
          "width": 160,
          "height": 56,
          "fontSize": 44,
          "color": "#f5f5f5"
        },
        {
          "type": "text",
          "source": "player.status",
          "x": 24,
          "y": 162,
          "width": 100,
          "height": 14,
          "fontSize": 10,
          "color": "#49e58f"
        },
        {
          "type": "time",
          "source": "duration",
          "x": 104,
          "y": 162,
          "width": 80,
          "height": 14,
          "fontSize": 10,
          "align": "right",
          "color": "#a9a9a9"
        },
        {
          "type": "spectrum",
          "x": 44,
          "y": 190,
          "width": 140,
          "height": 60,
          "color": "#f5f5f5"
        },
        {
          "type": "seekbar",
          "x": 24,
          "y": 276,
          "width": 332,
          "height": 6
        },
        {
          "type": "volume",
          "x": 172,
          "y": 382,
          "width": 130,
          "height": 6
        },
        {
          "type": "button",
          "action": "player.previous",
          "x": 22,
          "y": 292,
          "width": 54,
          "height": 54,
          "states": {
            "normal": "assets/previous.png",
            "hover": "assets/previous-hover.png",
            "pressed": "assets/previous-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.togglePlay",
          "x": 86,
          "y": 292,
          "width": 54,
          "height": 54,
          "states": {
            "normal": "assets/play.png",
            "hover": "assets/play-hover.png",
            "pressed": "assets/play-pressed.png",
            "active": "assets/play-active.png"
          }
        },
        {
          "type": "button",
          "action": "player.stop",
          "x": 150,
          "y": 292,
          "width": 54,
          "height": 54,
          "states": {
            "normal": "assets/stop.png",
            "hover": "assets/stop-hover.png",
            "pressed": "assets/stop-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.next",
          "x": 214,
          "y": 292,
          "width": 54,
          "height": 54,
          "states": {
            "normal": "assets/next.png",
            "hover": "assets/next-hover.png",
            "pressed": "assets/next-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.open",
          "x": 278,
          "y": 292,
          "width": 54,
          "height": 54,
          "states": {
            "normal": "assets/open.png",
            "hover": "assets/open-hover.png",
            "pressed": "assets/open-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.repeat",
          "x": 22,
          "y": 362,
          "width": 46,
          "height": 46,
          "states": {
            "normal": "assets/repeat.png",
            "hover": "assets/repeat-hover.png",
            "pressed": "assets/repeat-pressed.png",
            "active": "assets/repeat-active.png"
          }
        },
        {
          "type": "button",
          "action": "player.shuffle",
          "x": 68,
          "y": 362,
          "width": 46,
          "height": 46,
          "states": {
            "normal": "assets/shuffle.png",
            "hover": "assets/shuffle-hover.png",
            "pressed": "assets/shuffle-pressed.png",
            "active": "assets/shuffle-active.png"
          }
        },
        {
          "type": "button",
          "action": "window.equalizer",
          "x": 114,
          "y": 362,
          "width": 46,
          "height": 46,
          "states": {
            "normal": "assets/equalizer.png",
            "hover": "assets/equalizer-hover.png",
            "pressed": "assets/equalizer-pressed.png",
            "active": "assets/equalizer-active.png"
          }
        },
        {
          "type": "button",
          "action": "app.skins",
          "x": 312,
          "y": 362,
          "width": 46,
          "height": 46,
          "states": {
            "normal": "assets/skins.png",
            "hover": "assets/skins-hover.png",
            "pressed": "assets/skins-pressed.png"
          }
        },
        {
          "type": "playlist",
          "x": 28,
          "y": 422,
          "width": 324,
          "height": 166
        }
      ]
    }
  }
}
