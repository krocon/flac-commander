          "height": 8
        },
        {
          "type": "volume",
          "x": 174,
          "y": 319,
          "width": 78,
          "height": 8
        },
        {
          "type": "button",
          "action": "player.open",
          "x": 48,
          "y": 232,
          "width": 52,
          "height": 52,
          "states": {
            "normal": "assets/open.png",
            "hover": "assets/open-hover.png",
            "pressed": "assets/open-pressed.png"
