{
  "formatVersion": 1,
  "id": "io.github.krocon.split",
  "name": "Split",
  "version": "1.0.0",
  "author": "FLAC Commander",
  "description": "Half white, half red, a thick black line around it and two heavy black knobs.",
  "keywords": [
    "bold",
    "flat",
    "red",
    "white",
    "black",
    "graphic",
    "light"
  ],
  "preview": "preview.webp",
  "theme": {
    "background": "#fbfaf7",
    "surface": "#ffffff",
    "surfaceRaised": "#ffffff",
    "foreground": "#131313",
    "muted": "#505050",
    "accent": "#b5301b",
    "accentContrast": "#ffffff",
    "border": "#131313",
    "ok": "#0b5a2b",
    "danger": "#b5301b",
    "focus": "#1f5fbf",
    "fontFamily": "\"Avenir Next\", \"Segoe UI\", \"Helvetica Neue\", sans-serif",
    "fontMono": "\"Avenir Next\", \"Segoe UI\", \"Helvetica Neue\", sans-serif",
    "radius": 8
  },
  "windows": {
    "player": {
      "layout": "absolute",
      "width": 380,
      "height": 516,
      "background": "assets/background.png",
      "titleBar": "#fbfaf7",
      "collapsedHeight": 348,
      "resize": {
        "stretchY": 427
      },
      "components": [
        {
          "type": "text",
          "source": "track.title",
          "x": 46,
          "y": 42,
          "width": 230,
          "height": 26,
          "fontSize": 18,
          "color": "#131313"
        },
        {
          "type": "text",
          "source": "track.artist",
          "x": 46,
          "y": 68,
          "width": 230,
          "height": 18,
          "fontSize": 12,
          "color": "#b5301b"
        },
        {
          "type": "time",
          "source": "position",
          "x": 46,
          "y": 104,
          "width": 110,
          "height": 44,
          "fontSize": 32,
          "color": "#131313"
        },
        {
          "type": "spectrum",
          "x": 164,
          "y": 112,
          "width": 90,
          "height": 32,
          "color": "#131313"
        },
        {
          "type": "text",
          "source": "player.status",
          "x": 258,
          "y": 112,
          "width": 78,
          "height": 14,
          "fontSize": 10,
          "align": "right",
          "color": "#b5301b"
        },
        {
