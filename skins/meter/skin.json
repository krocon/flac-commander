{
  "formatVersion": 1,
  "id": "io.github.krocon.meter",
  "name": "Meter",
  "version": "1.0.0",
  "author": "FLAC Commander",
  "description": "Dark steel with two meter windows, a cassette in its bay and a red ring around play.",
