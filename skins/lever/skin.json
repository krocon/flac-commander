{
  "formatVersion": 1,
  "id": "io.github.krocon.lever",
  "name": "Lever",
  "version": "1.0.0",
  "author": "FLAC Commander",
  "description": "A grey front with white square keys, one marked red, a scale with a red pointer and vents.",
  "keywords": [
    "grey",
    "light",
    "minimal",
    "functional",
    "keys",
    "sixties"
  ],
  "preview": "preview.webp",
  "theme": {
    "background": "#b9bbbd",
    "surface": "#e9e9e4",
    "surfaceRaised": "#ffffff",
    "foreground": "#1b1c1d",
    "muted": "#3f4245",
    "accent": "#8c1d12",
    "accentContrast": "#ffffff",
    "border": "#77797c",
    "ok": "#0b5a2b",
    "danger": "#8c1d12",
    "focus": "#1f5fbf",
    "fontFamily": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "fontMono": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "radius": 1
  },
  "windows": {
    "player": {
      "layout": "absolute",
      "width": 380,
      "height": 452,
      "background": "assets/background.png",
      "collapsedHeight": 284,
      "resize": {
        "stretchY": 363
      },
      "components": [
        {
          "type": "text",
          "source": "track.title",
          "x": 24,
          "y": 20,
          "width": 260,
          "height": 24,
          "fontSize": 17,
          "color": "#1b1c1d"
        },
        {
          "type": "text",
          "source": "track.artist",
          "x": 24,
          "y": 44,
          "width": 260,
          "height": 18,
          "fontSize": 12,
          "color": "#3f4245"
        },
        {
          "type": "time",
          "source": "position",
          "x": 34,
          "y": 84,
          "width": 90,
          "height": 34,
          "fontSize": 24,
          "color": "#1b1c1d"
        },
        {
          "type": "spectrum",
          "x": 130,
          "y": 88,
          "width": 130,
          "height": 28,
          "color": "#8c1d12"
        },
        {
          "type": "text",
          "source": "player.status",
          "x": 262,
          "y": 86,
          "width": 84,
          "height": 14,
          "fontSize": 10,
          "align": "right",
          "color": "#8c1d12"
        },
        {
          "type": "time",
          "source": "duration",
          "x": 262,
          "y": 102,
          "width": 84,
          "height": 14,
          "fontSize": 11,
          "align": "right",
          "color": "#3f4245"
        },
        {
          "type": "seekbar",
          "x": 24,
          "y": 145,
          "width": 332,
          "height": 8
        },
        {
          "type": "volume",
          "x": 168,
          "y": 252,
          "width": 90,
          "height": 8
        },
        {
          "type": "button",
          "action": "player.open",
          "x": 40,
          "y": 166,
          "width": 60,
          "height": 60,
          "states": {
            "normal": "assets/open.png",
            "hover": "assets/open-hover.png",
            "pressed": "assets/open-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.previous",
          "x": 100,
          "y": 166,
          "width": 60,
          "height": 60,
          "states": {
            "normal": "assets/previous.png",
            "hover": "assets/previous-hover.png",
            "pressed": "assets/previous-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.togglePlay",
