          "y": 166,
          "width": 60,
          "height": 60,
          "states": {
            "normal": "assets/play.png",
            "hover": "assets/play-hover.png",
            "pressed": "assets/play-pressed.png",
            "active": "assets/play-active.png"
          }
        },
        {
          "type": "button",
          "action": "player.next",
          "x": 220,
          "y": 166,
          "width": 60,
          "height": 60,
          "states": {
            "normal": "assets/next.png",
            "hover": "assets/next-hover.png",
            "pressed": "assets/next-pressed.png"
          }
        },
        {
          "type": "button",
          "action": "player.stop",
          "x": 280,
          "y": 166,
          "width": 60,
          "height": 60,
          "states": {
            "normal": "assets/stop.png",
            "hover": "assets/stop-hover.png",
            "pressed": "assets/stop-pressed.png"
          }
        },
        {
