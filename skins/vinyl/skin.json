          "y": 120,
          "width": 80,
          "height": 14,
          "fontSize": 11,
          "align": "right",
          "color": "#a0a9b3"
        },
        {
          "type": "seekbar",
          "x": 344,
          "y": 142,
          "width": 280,
          "height": 8
        },
        {
          "type": "volume",
          "x": 344,
          "y": 336,
          "width": 280,
          "height": 8
        },
        {
