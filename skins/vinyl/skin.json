{
  "formatVersion": 1,
  "id": "io.github.krocon.vinyl",
  "name": "Vinyl",
  "version": "1.0.0",
  "author": "FLAC Commander",
  "description": "A soft, dark turntable: a record under the needle and controls pressed out of the surface.",
  "keywords": [
    "turntable",
    "record",
    "vinyl",
    "dark",
    "soft",
    "neumorphic",
    "landscape"
  ],
  "preview": "preview.webp",
  "theme": {
    "background": "#23262b",
    "surface": "#1c1f23",
    "surfaceRaised": "#2d3138",
    "foreground": "#e9ecf0",
    "muted": "#a0a9b3",
    "accent": "#66b5f5",
    "accentContrast": "#0a1622",
    "border": "#14161a",
    "ok": "#7fdca0",
    "danger": "#ff9d94",
    "focus": "#ffd166",
    "fontFamily": "\"SF Pro Rounded\", \"Avenir Next\", \"Segoe UI\", sans-serif",
    "fontMono": "\"SF Pro Rounded\", \"Avenir Next\", \"Segoe UI\", sans-serif",
    "radius": 8
  },
  "windows": {
    "player": {
      "layout": "absolute",
      "width": 640,
      "height": 562,
      "background": "assets/background.png",
      "collapsedHeight": 398,
      "resize": {
        "stretchY": 475
      },
      "components": [
        {
          "type": "spinner",
          "x": 112,
          "y": 134,
          "width": 96,
          "height": 96,
          "period": 1800,
          "source": "track.cover",
          "states": {
            "normal": "assets/label.png"
          }
        },
        {
          "type": "image",
          "x": 153,
          "y": 175,
          "width": 14,
          "height": 14,
          "states": {
            "normal": "assets/spindle.png"
          }
        },
        {
          "type": "text",
          "source": "track.title",
          "x": 344,
          "y": 34,
          "width": 280,
          "height": 26,
          "fontSize": 18,
          "color": "#e9ecf0"
        },
        {
          "type": "text",
          "source": "track.artist",
          "x": 344,
          "y": 62,
          "width": 280,
          "height": 18,
          "fontSize": 13,
          "color": "#66b5f5"
        },
        {
          "type": "text",
          "source": "player.status",
          "x": 344,
          "y": 86,
          "width": 280,
          "height": 14,
          "fontSize": 10,
          "color": "#a0a9b3"
        },
        {
