{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FLAC Commander",
  "version": "../package.json",
  "identifier": "io.github.krocon.flac-commander",
  "build": {
    "frontendDist": "../dist/flac-commander/browser",
    "devUrl": "http://localhost:1460",
    "beforeDevCommand": "pnpm start",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FLAC Commander",
        "width": 560,
        "height": 720,
        "minWidth": 380,
        "minHeight": 420,
        "resizable": true,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: skin: http://skin.localhost cover: http://cover.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Marc Kronberg",
    "copyright": "© 2026 Marc Kronberg",
    "targets": [
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage",
      "msi",
      "nsis"
    ],
    "category": "Music",
    "shortDescription": "Skinnable music player",
    "longDescription": "FLAC Commander is a skinnable music player for local music libraries on macOS, Windows and Linux with a native audio engine.",
    "homepage": "https://github.com/krocon/flac-commander",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
